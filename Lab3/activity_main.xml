<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity = "center_vertical|left|start"
    android:layout_margin="20dp"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ліхтарик"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity = "center"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Білий"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#FF0000"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Червоний"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#0000FF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Синій"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#00FF00"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Зелений"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#00FFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnCyan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ціан"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#D3D3D3"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLightGray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Світло сірий"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#FF00FF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnMagenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Магнета"/>
    </LinearLayout>

</LinearLayout>
